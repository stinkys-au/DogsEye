<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>DogsEye</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DogsEye.Core\DogsEye.Core.csproj" />
    <Content Include="..\..\artifacts\native\DogsEye.Tobii.dll" Link="DogsEye.Tobii.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\artifacts\native\tobii_gameintegration_x64.dll" Link="tobii_gameintegration_x64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildTobiiAdapter" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="..\..\native\DogsEye.Tobii.cpp;..\..\sdk\include\tobii_gameintegration.h;..\..\scripts\build-native.ps1"
          Outputs="..\..\artifacts\native\DogsEye.Tobii.dll">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-native.ps1&quot;" />
  </Target>
</Project>
